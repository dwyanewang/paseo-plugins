{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node", "react"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "index.*.ts",
    "index.*.tsx",
    "client/**/*",
    "server/**/*",
    "shared/**/*",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
